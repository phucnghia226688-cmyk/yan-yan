rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isLoggedIn() {
      return request.auth != null;
    }
    
    function getUserEmail() {
      return request.auth != null && request.auth.token.email != null ? request.auth.token.email : '';
    }
    
    function isMasterAdmin() {
      return isLoggedIn() && (
        getUserEmail() == 'admin@nbgym.com' ||
        (exists(/databases/$(database)/documents/registered_emails/$(getUserEmail())) &&
         exists(/databases/$(database)/documents/tenant_accounts/$(get(/databases/$(database)/documents/registered_emails/$(getUserEmail())).data.tenantId)) &&
         get(/databases/$(database)/documents/tenant_accounts/$(get(/databases/$(database)/documents/registered_emails/$(getUserEmail())).data.tenantId)).data.role == 'admin')
      );
    }
    
    function getUserTenantId() {
      let email = getUserEmail();
      return email == 'admin@nbgym.com' 
        ? 'master-admin' 
        : (exists(/databases/$(database)/documents/registered_emails/$(email)) 
            ? get(/databases/$(database)/documents/registered_emails/$(email)).data.tenantId 
            : 'default');
    }
    
    function isTenantPT() {
      let tId = getUserTenantId();
      return isLoggedIn() && 
        getUserEmail() != 'admin@nbgym.com' &&
        exists(/databases/$(database)/documents/tenant_accounts/$(tId)) &&
        get(/databases/$(database)/documents/tenant_accounts/$(tId)).data.role == 'tenant' &&
        get(/databases/$(database)/documents/tenant_accounts/$(tId)).data.status != 'suspended';
    }

    // Public or auth readable collections for tenant resolution
    match /registered_emails/{email} {
      allow read: if true;
      allow write: if isLoggedIn();
    }
    
    match /tenant_accounts/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }
    
    match /cloud_backups/{docId} {
      allow read, write: if isLoggedIn() && (isMasterAdmin() || docId == getUserTenantId());
    }

    match /shadow_backups/{docId} {
      allow read, write: if isLoggedIn() && (isMasterAdmin() || docId == getUserTenantId());
    }

    match /revenues/{docId} {
      allow read, write: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && resource.data.tenantId == getUserTenantId()));
      allow create: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && request.resource.data.tenantId == getUserTenantId()));
    }

    match /expenses/{docId} {
      allow read, update, delete: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && resource.data.tenantId == getUserTenantId()));
      allow create: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && request.resource.data.tenantId == getUserTenantId()));
    }

    match /payments/{docId} {
      allow read, update, delete: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && resource.data.tenantId == getUserTenantId()));
      allow create: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && request.resource.data.tenantId == getUserTenantId()));
    }

    match /settings/{docId} {
      allow read, write: if isLoggedIn();
    }

    match /auditLogs/{docId} {
      allow read, update, delete: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && resource.data.tenantId == getUserTenantId()));
      allow create: if isLoggedIn() && (isMasterAdmin() || (isTenantPT() && request.resource.data.tenantId == getUserTenantId()));
    }

    match /all_users/{docId} {
      allow read, write: if isLoggedIn() && isMasterAdmin();
    }

    match /user_sessions/{docId} {
      allow read, write: if isLoggedIn();
    }
    
    // Operational collections (clients, checkIns, appointments, programs, pdfDocuments, etc.)
    match /{collection}/{docId} {
      allow read, write: if isLoggedIn() && isMasterAdmin();
      allow read, update, delete: if isLoggedIn() && isTenantPT() && (
        resource.data.tenantId == getUserTenantId() || 
        resource.data.pt_id == request.auth.uid || 
        resource.data.assignedPtId == request.auth.uid
      );
      allow create: if isLoggedIn() && isTenantPT() && (
        request.resource.data.tenantId == getUserTenantId() || 
        request.resource.data.pt_id == request.auth.uid || 
        request.resource.data.assignedPtId == request.auth.uid
      );
    }
  }
}
